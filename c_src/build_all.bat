@echo off
rem Build the Star Wars oracle (x64, VS2022 cl).
rem
rem Target:
rem   tests\refrun.exe   the reference harness: the real ROMs on the board model
rem                      (board.cpp), driven by a script, recording what the ROM did
rem
rem The ROM images are read at run time from ..\disasm\build (python ..\disasm\image.py).
call "C:\Program Files\Microsoft Visual Studio\2022\Community\Common7\Tools\VsDevCmd.bat" -arch=amd64 -no_logo
cd /d "%~dp0"
if not exist obj mkdir obj

rem ---- the vendored 6809 core and the speech chip core: their own warning level
cl /nologo /O2 /W3 /std:c++17 /EHsc /D_CRT_SECURE_NO_WARNINGS /Icpu /c cpu\cpu_m6809.cpp /Foobj\ || exit /b 1
cl /nologo /O2 /W3 /std:c++17 /EHsc /D_CRT_SECURE_NO_WARNINGS /I. /c tms5220.cpp /Foobj\ || exit /b 1

rem ---- the chip models: plain C
set CFLAGS=/nologo /O2 /W4 /std:c11 /D_CRT_SECURE_NO_WARNINGS /I.
for %%f in (avg mathbox x2212 riot6532) do (
  cl %CFLAGS% /c %%f.c /Foobj\ || exit /b 1
)

rem ---- the board and the harness
set CXXFLAGS=/nologo /O2 /W4 /std:c++17 /EHsc /D_CRT_SECURE_NO_WARNINGS /I. /Icpu
echo === tests\refrun.exe
cl %CXXFLAGS% /Foobj\ hw.cpp board.cpp tests\refrun.cpp obj\cpu_m6809.obj obj\tms5220.obj obj\avg.obj obj\mathbox.obj obj\x2212.obj obj\riot6532.obj /Fe:tests\refrun.exe || exit /b 1

rem ---- the cycle table tool (tools\xlate.py runs it)
echo === tests\cyctab.exe
cl %CXXFLAGS% /Foobj\ tests\cyctab.cpp obj\cpu_m6809.obj /Fe:tests\cyctab.exe || exit /b 1
if "%1"=="tools" (echo TOOLS OK & exit /b 0)

rem ---- the C port (generated by tools\xlate.py into gen\) and its verifier
if not exist gen\registry.c (echo MISSING gen\ - run python tools\xlate.py & exit /b 1)
if not exist gen_snd\registry.c (echo MISSING gen_snd\ - run python tools\xlate.py sound & exit /b 1)
if not exist obj\gen mkdir obj\gen
if not exist obj\gen_snd mkdir obj\gen_snd
if not exist obj\lockstep mkdir obj\lockstep
echo === the C port (gen\*.c)
del /q obj\gen\*.obj 2>nul
cl /nologo /O2 /W3 /std:c11 /D_CRT_SECURE_NO_WARNINGS /I. /c gen\*.c hand\*.c sw_rt.c /Foobj\gen\ || exit /b 1
echo === the C port, sound program (gen_snd\*.c)
del /q obj\gen_snd\*.obj 2>nul
cl /nologo /O2 /W3 /std:c11 /D_CRT_SECURE_NO_WARNINGS /I. /c gen_snd\*.c /Foobj\gen_snd\ || exit /b 1
cl /nologo /O2 /W3 /std:c11 /D_CRT_SECURE_NO_WARNINGS /DSW_SND_PROGRAM /I. /c sw_rt.c /Foobj\gen_snd\ || exit /b 1
echo === tests\lockstep.exe
cl %CXXFLAGS% /DLOCKSTEP /DSW_SND_PROGRAM /c tests\lockstep.cpp /Foobj\lockstep\lockstep_snd.obj || exit /b 1
cl %CXXFLAGS% /DLOCKSTEP /Foobj\lockstep\ hw.cpp board.cpp tests\refrun.cpp tests\lockstep.cpp obj\lockstep\lockstep_snd.obj obj\gen\*.obj obj\gen_snd\*.obj obj\cpu_m6809.obj obj\tms5220.obj obj\avg.obj obj\mathbox.obj obj\x2212.obj obj\riot6532.obj /Fe:tests\lockstep.exe /link /STACK:1073741824 || exit /b 1

echo ALL BUILDS OK
